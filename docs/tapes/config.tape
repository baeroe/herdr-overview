# Shared settings, included by the other tapes (Source). Run the tapes through docs/screenshots.sh,
# which starts the sandboxed herdr server that $HERDR_DEMO attaches to.
Set Shell bash
Set FontFamily "Menlo"
Set FontSize 14
Set Width 1600
Set Height 900
Set Padding 16
Set Theme "Dracula"
Set TypingSpeed 30ms
Set CursorBlink false
